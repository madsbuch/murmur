{
  "name": "murmur",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Private notes and files shared directly between nearby devices.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run lint && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "tauri": "tauri",
    "android": "node scripts/mobile.mjs android dev",
    "android:build": "node scripts/mobile.mjs android build --debug --target aarch64",
    "android:release": "node scripts/mobile.mjs android build --apk --target aarch64 --target armv7 && python3 scripts/android-signing.py sign && python3 scripts/check-android-scanner.py --apk out/Murmur-android-universal.apk",
    "signing:verify": "python3 scripts/android-signing.py verify",
    "ios": "node scripts/mobile.mjs ios dev",
    "ios:build": "node scripts/mobile.mjs ios build --debug",
    "macos:release": "bash scripts/build-macos.sh",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ui": "playwright test",
    "lint": "eslint src native.ts tests vite.config.ts playwright.config.ts --max-warnings 0"
  },
  "dependencies": {
    "@scure/bip39": "2.4.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-barcode-scanner": "2.5.3",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "diff": "9.0.0",
    "dompurify": "3.4.18",
    "jsqr": "1.4.0",
    "marked": "18.0.7",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8"
  }
}
